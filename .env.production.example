# Copie este arquivo para .env.production somente na VPS.
# Este arquivo não deve ser versionado nem copiado para máquinas locais.
SECRET_KEY=defina-uma-chave-secreta-de-producao
DEBUG=False
ALLOWED_HOSTS=dominio-da-aplicacao,ip-da-vps

DB_ENGINE=postgresql
POSTGRES_DB=igreja_crm
POSTGRES_USER=igreja_crm
POSTGRES_PASSWORD=defina-a-senha-de-producao
POSTGRES_HOST=host-postgresql-da-vps
POSTGRES_PORT=5432
